# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Node / Frontend
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# Data volume outputs (keep folder structure, ignore large datasets)
data/**/*.parquet
data/**/*.json
# The pre-built global dataset ships with the backend so the deployment can
# serve it without running the ETL.
!backend/data/*.parquet
!backend/data/metadata.json
data/raw/*
!data/raw/.gitkeep

# OS / IDE
.DS_Store
.env
.env.local
